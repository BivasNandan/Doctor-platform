# Copy to .env.local and adjust. Every VITE_* value is shipped to the browser:
# never put secrets here.

# Data source: "demo" (fictional in-memory data, no backend) or "api" (real backend).
VITE_CAREWELL_DATA_MODE=demo

# Base URL of the REST API. A relative path is proxied by the Vite dev server
# (see VITE_DEV_PROXY_TARGET), which avoids CORS and keeps cookies same-site.
# In production use the real origin, e.g. https://api.carewell.example/api/v1
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` forwards requests starting with /api.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Send cookies with API requests (required for cookie-based sessions).
VITE_API_SEND_CREDENTIALS=true

# Optional: URL prefix when hosted in a sub-folder (GitHub Pages uses /Doctor-platform/).
# VITE_BASE_PATH=/
